# Identidade pública
NEXT_PUBLIC_SITE_NAME=NEXUS BRASIL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Feature flags — ative uma por vez somente após configurar e testar os requisitos
NEXUS_WATCH_ENABLED=false
AUTH_ENABLED=false
MARKETPLACE_ENABLED=false
STARKIA_ENABLED=false

# Supabase — Auth usa anon key; operações financeiras usam service role no servidor
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_OAUTH_PROVIDERS=

# Nexus Watch — token Read Access da API v3/v4 do TMDB, somente no servidor
TMDB_ACCESS_TOKEN=
# Para uso comercial, registre a aprovação/licença aplicável e use um logo oficial aprovado.
TMDB_COMMERCIAL_APPROVED=false
NEXT_PUBLIC_TMDB_LOGO_URL=

# Nexus IA — nunca exponha chaves no navegador.
# Produção/Preview: Groq Cloud (OpenAI-compatible).
# Na Vercel, GROQ_API_KEY é a única variável obrigatória; provider, endpoint e modelo têm defaults seguros.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b

# Desenvolvimento local opcional com o mesmo Ollama usado pelo JARVIS.
# Troque AI_PROVIDER para ollama somente fora de produção.
OLLAMA_OPENAI_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=jarvis-local

# Compatibilidade com provider customizado/legado
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Mercado Pago — use credenciais TEST durante o desenvolvimento
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_MODE=true

# StarkIA — segredo aleatório com pelo menos 32 caracteres para derivar hashes dos tokens
STARKIA_RELAY_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=

# Segurança e limites
APP_SECRET=
CRON_SECRET=
AI_FREE_DAILY_LIMIT=10
MARKETPLACE_COMMISSION_PERCENT=8
